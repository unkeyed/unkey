{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "maxSize": 1572864
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "noAmbiguousAnchorText": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noChildrenProp": "off",
        "useJsxKeyInIterable": "error",
        "noUnsafeOptionalChaining": "error",
        "useHookAtTopLevel": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noUselessElse": "error",
        "useImportType": "error",
        "useFragmentSyntax": "error",
        "useAsConstAssertion": "error",
        "useTemplate": "error",
        "noYodaExpression": "error",
        "noUnusedTemplateLiteral": "error",
        "noNegationElse": "off",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "noParameterAssign": "error",
        "useNumberNamespace": "error",
        "useSingleVarDeclarator": "error",
        "noDefaultExport": "error",
        "useExportType": "error",
        "useThrowOnlyError": "error",
        "noShoutyConstants": "error",
        "useDefaultParameterLast": "error"
      },
      "performance": {
        "noDelete": "off"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "useIsArray": "error",
        "noFallthroughSwitchClause": "error",
        "noExplicitAny": "error",
        "useIterableCallbackReturn": "off",
        "preset": "recommended",
        "noVar": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": [
              "assert",
              "clear",
              "count",
              "countReset",
              "debug",
              "dir",
              "dirxml",
              "error",
              "group",
              "groupCollapsed",
              "groupEnd",
              "info",
              "table",
              "time",
              "timeEnd",
              "timeLog",
              "trace",
              "warn"
            ]
          }
        }
      },
      "complexity": {
        "noForEach": "off",
        "noExtraBooleanCast": "error",
        "noUselessTernary": "error",
        "noUselessTypeConstraint": "error",
        "noUselessStringConcat": "error",
        "useOptionalChain": "error",
        "useDateNow": "error"
      }
    },
    "includes": [
      "**",
      "!**/.vitest",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.nuxt",
      "!apps/docs/docs.json",
      "!internal/api/**",
      "!internal/auth-migrator/**",
      "!apps/dashboard/gen/proto/**/*.ts",
      "!**/routeTree.gen.ts",
      "!**/.wrangler",
      "!**/.react-email",
      "!**/.content-collections",
      "!**/.source",
      "!**/.trigger",
      "!**/*.css",
      "!**/*.astro",
      "!**/.blume/**",
      "!**/.blume-verify/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "enabled": true,
    "lineWidth": 100,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.nuxt",
      "!**/.wrangler",
      "!**/.react-email",
      "!**/.content-collections",
      "!**/.source",
      "!**/.trigger",
      "!internal/api/**",
      "!internal/auth-migrator/**",
      "!internal/proto/generated/**/*.ts",
      "!apps/dashboard/gen/proto/**/*.ts",
      "!apps/docs/docs.json",
      "!**/routeTree.gen.ts",
      "!**/*.css",
      "!**/*.astro",
      "!**/.blume/**",
      "!**/.blume-verify/**"
    ]
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } },
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.nuxt",
      "!**/.wrangler",
      "!**/.react-email",
      "!**/.content-collections",
      "!internal/api/**",
      "!internal/auth-migrator/**",
      "!internal/proto/generated/**/*.ts",
      "!apps/dashboard/gen/proto/**/*.ts",
      "!apps/docs/docs.json",
      "!**/routeTree.gen.ts",
      "!**/*.astro",
      "!**/.blume/**",
      "!**/.blume-verify/**"
    ]
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/cmd/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**",
        "**/tools/**",
        "**/v1_*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/page.tsx",
        "**/layout.tsx",
        "**/loading.tsx",
        "**/error.tsx",
        "**/not-found.tsx",
        "**/route.ts",
        "**/*.config.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/design/examples/**", "apps/design/docs/**/meta.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/portal/**", "apps/design/**"],
      "linter": {
        "rules": {
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "fix": "safe",
              "options": {
                "functions": ["cn", "cva", "clsx"]
              }
            }
          }
        }
      }
    }
  ]
}
