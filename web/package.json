{
  "name": "unkey",
  "workspaces": ["apps/*", "packages/*"],
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm turbo run build",
    "fmt": "pnpm biome format . --write && pnpm biome check . --write",
