#!/usr/bin/env perl
#MISE description="Test SQL wildcard lint detection"

use v5.44;
use warnings FATAL => 'all';
use autodie        qw(chdir close mkdir open);
use Cwd            qw(abs_path getcwd);
use File::Basename qw(dirname);
use File::Path     qw(make_path);
use File::Temp     qw(tempdir);
use IPC::Open3     qw(open3);
use Symbol         qw(gensym);
use Test::More;

my $linter = abs_path('.mise/tasks/lint-sql-wildcards');

sub lint_source ( $path, $source ) {
    my $directory = tempdir( CLEANUP => 1 );
    my $full_path = "$directory/$path";
    make_path( dirname($full_path) );

    open my $file, '>', $full_path;
    print {$file} $source;
    close $file;

    system 'git', '-C', $directory, 'init', '--quiet';
    die "git init failed\n" if $? != 0;

    my $original_directory = getcwd();
    chdir $directory;
    my $stderr       = gensym();
    my $pid          = open3( undef, my $stdout, $stderr, $linter );
    my $error_output = do { local $/; <$stderr> // '' };
    my $output       = do { local $/; <$stdout> // '' };
    waitpid $pid, 0;
    my $status = $? >> 8;
    chdir $original_directory;

    return ( $status, $output . $error_output );
}

sub permits ( $name, $path, $source ) {
    my ( $status, $output ) = lint_source( $path, $source );
    is $status, 0, $name or diag $output;
}

sub rejects ( $name, $path, $source, $kind ) {
    my ( $status, $output ) = lint_source( $path, $source );
    isnt $status, 0, $name;
    like $output, qr/forbidden \Q$kind\E/, "$name reports its reason";
}

permits 'explicit SQL projection', 'query.sql', <<'SQL';
SELECT id, name FROM users;
SQL

permits 'SQL aggregate star', 'query.sql', <<'SQL';
SELECT COUNT(*) FROM users;
SQL

permits 'SQL comments, literals, and permission targets', 'query.sql', <<'SQL';
-- SELECT * FROM ignored_comment
SELECT 'SELECT * FROM ignored_literal' AS example;
GRANT SELECT ON database.* TO user;
SQL

permits 'Go comments and non-SQL prose', 'main.go', <<'GO';
package main

// SELECT * FROM comments must not count.
const guidance = "Avoid wildcard SQL projections"
GO

permits 'explicit Drizzle projection', 'web/apps/dashboard/query.ts', <<'TS';
db.query.users.findMany({ columns: { id: true } });
TS

rejects 'SQL wildcard', 'query.sql', <<'SQL', 'SELECT wildcard';
SELECT * FROM users;
SQL

rejects 'SQL wildcard after another column', 'query.sql',
  <<'SQL', 'SELECT wildcard';
SELECT id, * FROM users;
SQL

rejects 'qualified SQL wildcard', 'query.sql',
  <<'SQL', 'qualified wildcard selection';
SELECT users.* FROM users;
SQL

rejects 'sqlc embed', 'query.sql', <<'SQL', 'sqlc.embed all-column selection';
SELECT sqlc.embed(users) FROM users;
SQL

rejects 'Go raw SQL wildcard', 'main.go', <<'GO', 'SELECT wildcard';
package main

const query = `SELECT * FROM users`
GO

rejects 'TypeScript raw SQL wildcard', 'query.ts', <<'TS', 'SELECT wildcard';
const query = "SELECT * FROM users";
TS

rejects 'Drizzle query without columns', 'web/apps/dashboard/query.ts',
  <<'TS', 'missing Drizzle query columns projection';
db.query.users.findMany({ where: eq(users.id, id) });
TS

rejects 'Drizzle all-column relation', 'web/apps/dashboard/query.ts',
  <<'TS', 'implicit all-column Drizzle relation';
db.query.users.findMany({
  columns: { id: true },
  with: { memberships: true },
});
TS

rejects 'Drizzle negative projection', 'web/apps/dashboard/query.ts',
  <<'TS', 'non-positive Drizzle columns projection';
db.query.users.findMany({ columns: { secret: false } });
TS

rejects 'query-builder selectAll', 'query.ts',
  <<'TS', 'query-builder selectAll selection';
db.selectFrom("users").selectAll();
TS

rejects 'query-builder wildcard string', 'query.ts',
  <<'TS', 'query-builder string wildcard selection';
db.selectFrom("users").select("*");
TS

rejects 'empty Drizzle select', 'query.ts',
  <<'TS', 'empty query-builder .select()';
db.select().from(users);
TS

done_testing;
