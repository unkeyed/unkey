#!/usr/bin/env bash
#MISE description="Apply only this Git branch's schema changes (BRANCH=name [FROM=staging] [BASE_REF=origin/main])"
#MISE depends=["install-web"]
set -euo pipefail

if [ -z "${BRANCH:-}" ]; then
  echo "Error: BRANCH is required (e.g., BRANCH=florian-scratch mise run pscale-branch)"
  exit 1
fi

FROM="${FROM:-staging}"
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "staging" ] || [ "$BRANCH" = "$FROM" ]; then
  echo "Error: BRANCH must be a development branch, not main, staging, or FROM."
  exit 1
fi

BASE="$(git merge-base "${BASE_REF:-origin/main}" HEAD)"
TEMP="$(mktemp -d "$PWD/web/internal/db/.pscale-XXXXXX")"
PASSWORD_ID=""
cleanup() {
  if [ -n "$PASSWORD_ID" ]; then
    pscale password delete unkey "$BRANCH" "$PASSWORD_ID" --org unkey --force >/dev/null 2>&1 \
      || echo "Warning: temporary password cleanup failed; it expires after one hour." >&2
  fi
  rm -rf "$TEMP"
}
trap cleanup EXIT

git archive "$BASE" web/internal/db/src | tar -x -C "$TEMP"
echo "Planning schema changes since Git merge-base $BASE."
pnpm --dir=web/internal/db exec drizzle-kit generate --dialect=mysql \
  --schema="$TEMP/web/internal/db/src/schema/index.ts" --out="$TEMP/base"
pnpm --dir=web/internal/db exec drizzle-kit generate --dialect=mysql \
  --schema=./src/schema/index.ts --out="$TEMP/head"
pnpm --dir=web/internal/db exec node ./scripts/pscale-branch.mts \
  "$TEMP/base/meta/0000_snapshot.json" "$TEMP/head/meta/0000_snapshot.json" --check

pscale branch create unkey "$BRANCH" --org unkey --from "$FROM" --wait \
  || pscale branch show unkey "$BRANCH" --org unkey >/dev/null
PW="$(pscale password create unkey "$BRANCH" "local-$(date +%s)" --org unkey --role admin --ttl 1h --format json)"
PASSWORD_ID="$(echo "$PW" | jq -r '.id')"
USER="$(echo "$PW" | jq -r '.username | @uri')"
PASS="$(echo "$PW" | jq -r '.plain_text | @uri')"
HOST="$(echo "$PW" | jq -r '.access_host_url | @uri')"
export DRIZZLE_DATABASE_URL="mysql://$USER:$PASS@$HOST/unkey?ssl={}"
DRIZZLE_OUTPUT_DIR="$TEMP/live" pnpm --dir=web/internal/db exec drizzle-kit pull
pnpm --dir=web/internal/db exec node ./scripts/pscale-branch.mts \
  "$TEMP/base/meta/0000_snapshot.json" "$TEMP/head/meta/0000_snapshot.json" \
  "$TEMP/live/meta/0000_snapshot.json"
