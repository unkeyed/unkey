#!/usr/bin/env bash
#MISE description="Create PlanetScale branch and run drizzle migration (BRANCH=name [FROM=staging])"
#MISE depends=["install-web"]
set -euo pipefail

if [ -z "${BRANCH:-}" ]; then
  echo "Error: BRANCH is required (e.g., BRANCH=florian-scratch mise run pscale-branch)"
  exit 1
fi

FROM="${FROM:-staging}"
pscale branch create unkey "$BRANCH" --org unkey --from "$FROM" --wait \
  || pscale branch show unkey "$BRANCH" --org unkey >/dev/null
# drizzle-kit push needs DDL, so this one-shot credential must be admin; it is
# deleted when the task ends so ephemeral branches do not accumulate credentials.
PW="$(pscale password create unkey "$BRANCH" "local-$(date +%s)" --org unkey --role admin --ttl 1h --format json)"
PASSWORD_ID="$(echo "$PW" | jq -r '.id')"
USER="$(echo "$PW" | jq -r '.username | @uri')"
PASS="$(echo "$PW" | jq -r '.plain_text | @uri')"
HOST="$(echo "$PW" | jq -r '.access_host_url | @uri')"
trap 'pscale password delete unkey "$BRANCH" "$PASSWORD_ID" --org unkey --force >/dev/null 2>&1 || true' EXIT
DRIZZLE_DATABASE_URL="mysql://$USER:$PASS@$HOST/unkey?ssl={}" pnpm --dir=web/internal/db run migrate
