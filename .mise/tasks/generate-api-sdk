#!/usr/bin/env bash
#MISE description="Generate the dashboard API SDK from the local OpenAPI document"
#MISE depends=["install-web"]
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
target="${root}/web/internal/api"
stage="${target}/.speakeasy/staging/api-ts"
gen_config_url="https://raw.githubusercontent.com/unkeyed/sdks/main/api/ts/gen.yaml"

go generate ./svc/api/openapi

rm -rf "${stage}"
mkdir -p "${stage}"
curl --fail --location --silent --show-error "${gen_config_url}" --output "${stage}/gen.yaml"
node -e '
  const fs = require("node:fs");
  const path = process.argv[1];
  const config = fs.readFileSync(path, "utf8");
  const dual = "  moduleFormat: dual\n";
  if (config.split(dual).length !== 2) {
    throw new Error("Expected production gen.yaml to contain exactly one dual module format");
  }
  fs.writeFileSync(path, config.replace(dual, "  moduleFormat: esm\n"));
' "${stage}/gen.yaml"

(
  cd "${target}"
  speakeasy run \
    --target api-ts \
    --auto-yes \
    --minimal \
    --output console \
    --skip-compile \
    --skip-testing \
    --skip-upload-spec \
    --skip-versioning
)

test -d "${stage}/src"
node -e '
  const fs = require("node:fs");
  const path = require("node:path");
  const source = process.argv[1];
  const destination = process.argv[2];
  const registrationPath = path.join(destination, "hooks", "registration.ts");
  const registration = fs.readFileSync(registrationPath);

  fs.rmSync(destination, { recursive: true, force: true });
  fs.cpSync(source, destination, { recursive: true });
  fs.mkdirSync(path.dirname(registrationPath), { recursive: true });
  fs.writeFileSync(registrationPath, registration);

  const escapeJSDocWildcards = (directory) => {
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const entryPath = path.join(directory, entry.name);
      if (entry.isDirectory()) {
        escapeJSDocWildcards(entryPath);
      } else if (entry.name.endsWith(".ts")) {
        const sourceText = fs.readFileSync(entryPath, "utf8");
        const escapedText = sourceText
          .split("\n")
          .map((line) => /^\s*\*/.test(line) ? line.replaceAll("* /", "&#42;/") : line)
          .join("\n");
        fs.writeFileSync(entryPath, escapedText);
      }
    }
  };
  escapeJSDocWildcards(destination);
' "${stage}/src" "${target}/src"
rm -rf "${target}/esm"
rm -rf "${stage}"
pnpm --dir="${root}/web" --filter @unkey/api build
