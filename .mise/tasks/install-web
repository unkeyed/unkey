#!/usr/bin/env bash
#MISE description="Install frozen web dependencies"
#MISE hide=true
#MISE sources=[".mise/config.toml", ".mise/mise.lock", "web/package.json", "web/pnpm-lock.yaml", "web/pnpm-workspace.yaml", "web/{apps,internal}/*/package.json"]
#MISE outputs=["web/node_modules/.modules.yaml"]
set -euo pipefail

mise install --locked --yes node github:pnpm/pnpm
pnpm=$(mise which pnpm --tool github:pnpm/pnpm)
mise exec -- "$pnpm" --dir=web install --recursive --frozen-lockfile
