#!/usr/bin/env bash
#MISE description="Check focused, skipped, and unsafe TypeScript tests in changed test files"
set -euo pipefail

base="${1:?Provide a base revision}"
changed="$(mktemp)"
trap 'rm -f "$changed"' EXIT
git diff --name-only --diff-filter=ACMR -z "$base" -- web > "$changed"
files=()
while IFS= read -r -d '' path; do
  case "$path" in
    *.test.ts|*.test.tsx|*.spec.ts|*.spec.tsx|*/__tests__/*.ts|*/__tests__/*.tsx)
      files+=("${path#web/}")
      ;;
  esac
done < "$changed"

if [[ ${#files[@]} -eq 0 ]]; then
  echo "No changed TypeScript test files."
  exit 0
fi
pnpm --dir=web exec biome lint \
  --only=suspicious/noFocusedTests --only=suspicious/noSkippedTests \
  --only=suspicious/noExplicitAny --only=style/noNonNullAssertion \
  --error-on-warnings "${files[@]}"
