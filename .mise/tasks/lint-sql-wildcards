#!/usr/bin/env bash
#MISE description="Reject all-column SQL queries"
set -euo pipefail

# Keep this dependency-free and scan versioned plus untracked source so build
# output and vendored dependencies cannot affect the result. Tests may exercise
# wildcard parsing. Current production SQL, including migrations and schema
# definitions, is never exempt.
# One immutable historical migration is masked by exact statement below.
perl <<'PERL'
use strict;
use warnings;

open my $git, "-|", "git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"
  or die "unable to list source files: $!\n";
local $/ = "\0";
my @files = <$git>;
close $git or die "git ls-files failed\n";

my $violations = 0;

sub exempt_test {
  my ($path) = @_;
  return $path =~ m{(?:^|/)(?:testdata|fixtures|__tests__)(?:/|$)}
    || $path =~ /(?:_test\.go|\.(?:test|spec)\.[cm]?[jt]sx?|(?:_test|\.test|\.fixture)\.sql)$/;
}

sub blank {
  my ($text) = @_;
  $text =~ s/[^\n]/ /g;
  return $text;
}

sub mask_source_comments {
  my ($source, $path) = @_;
  my $masked = "";
  my $quote = "";

  for (my $i = 0; $i < length($source); $i++) {
    my $char = substr($source, $i, 1);
    my $next = substr($source, $i + 1, 1);

    if ($quote) {
      $masked .= $char;
      if ($char eq "\\" && ($quote ne "`" || $path !~ /\.go$/) && $i + 1 < length($source)) {
        $masked .= $next;
        $i++;
      } elsif ($char eq $quote) {
        $quote = "";
      }
      next;
    }

    if ($char eq '"' || $char eq "'" || $char eq "`") {
      $quote = $char;
      $masked .= $char;
      next;
    }
    if ($char eq "/" && $next eq "/") {
      my $end = index($source, "\n", $i);
      $end = length($source) if $end < 0;
      $masked .= blank(substr($source, $i, $end - $i));
      $i = $end - 1;
      next;
    }
    if ($char eq "/" && $next eq "*") {
      my $end = index($source, "*/", $i + 2);
      $end = length($source) - 2 if $end < 0;
      my $length = $end + 2 - $i;
      $masked .= blank(substr($source, $i, $length));
      $i += $length - 1;
      next;
    }
    $masked .= $char;
  }

  return $masked;
}

# Keep punctuation and offsets, but hide comments and string contents so braces
# and method names in prose cannot affect the TypeScript structural scanner.
sub mask_typescript_structure {
  my ($source) = @_;
  my $masked = mask_source_comments($source, "typescript");
  my $quote = "";
  for (my $i = 0; $i < length($masked); $i++) {
    my $char = substr($masked, $i, 1);
    if ($quote) {
      if ($char eq "\\" && $i + 1 < length($masked)) {
        substr($masked, $i, 1, " ");
        $i++;
        substr($masked, $i, 1, " ") unless substr($masked, $i, 1) eq "\n";
      } elsif ($char eq $quote) {
        $quote = "";
      } else {
        substr($masked, $i, 1, " ") unless $char eq "\n";
      }
    } elsif ($char eq '"' || $char eq "'" || $char eq "`") {
      $quote = $char;
    }
  }
  return $masked;
}

sub skip_space {
  my ($text, $position) = @_;
  $position++ while $position < length($text) && substr($text, $position, 1) =~ /\s/;
  return $position;
}

sub matching_delimiter {
  my ($text, $start) = @_;
  my %close = ("(" => ")", "[" => "]", "{" => "}");
  my $opening = substr($text, $start, 1);
  return -1 unless exists $close{$opening};
  my @stack = ($close{$opening});
  my $quote = "";
  for (my $i = $start + 1; $i < length($text); $i++) {
    my $char = substr($text, $i, 1);
    if ($quote) {
      $quote = "" if $char eq $quote;
      next;
    }
    if ($char eq '"' || $char eq "'" || $char eq "`") {
      $quote = $char;
    } elsif (exists $close{$char}) {
      push @stack, $close{$char};
    } elsif (@stack && $char eq $stack[-1]) {
      pop @stack;
      return $i unless @stack;
    }
  }
  return -1;
}

# Return [key, value start, value end] for ordinary literal object properties.
# Spreads, shorthand properties, computed keys and methods intentionally have no
# entry: callers treat them as dynamic when validating a projection object.
sub object_properties {
  my ($masked, $original, $open, $close) = @_;
  my @ranges;
  my $start = $open + 1;
  my @stack;
  my $quote = "";
  for (my $i = $start; $i <= $close; $i++) {
    my $char = $i == $close ? "," : substr($masked, $i, 1);
    if ($quote) {
      $quote = "" if $char eq $quote;
    } elsif ($char eq '"' || $char eq "'" || $char eq "`") {
      $quote = $char;
    } elsif ($char =~ /[({\[]/) {
      push @stack, $char;
    } elsif ($char =~ /[)}\]]/) {
      pop @stack if @stack;
    } elsif ($char eq "," && !@stack) {
      push @ranges, [$start, $i];
      $start = $i + 1;
    }
  }

  my @properties;
  RANGE: for my $range (@ranges) {
    my ($begin, $end) = @$range;
    $begin = skip_space($masked, $begin);
    next if $begin >= $end;
    my $colon = -1;
    @stack = ();
    $quote = "";
    for (my $i = $begin; $i < $end; $i++) {
      my $char = substr($masked, $i, 1);
      if ($quote) { $quote = "" if $char eq $quote; next; }
      if ($char eq '"' || $char eq "'") { $quote = $char; next; }
      if ($char =~ /[({\[]/) { push @stack, $char; next; }
      if ($char =~ /[)}\]]/) { pop @stack if @stack; next; }
      if ($char eq ":" && !@stack) { $colon = $i; last; }
    }
    if ($colon < 0) { push @properties, [undef, -1, -1, $begin]; next RANGE; }
    my $key_text = substr($original, $begin, $colon - $begin);
    $key_text =~ s/^\s+|\s+$//g;
    my $key;
    if ($key_text =~ /^([A-Za-z_\$][A-Za-z0-9_\$]*)$/) { $key = $1; }
    elsif ($key_text =~ /^(["'])([^"']+)\1$/) { $key = $2; }
    my $value_start = skip_space($masked, $colon + 1);
    my $value_end = $end;
    $value_end-- while $value_end > $value_start && substr($masked, $value_end - 1, 1) =~ /\s/;
    push @properties, [$key, $value_start, $value_end, $begin];
  }
  return @properties;
}

sub report_match {
  my ($path, $original, $offset, $kind) = @_;
  my $line = 1 + (substr($original, 0, $offset) =~ tr/\n//);
  my ($source_line) = (split /\n/, substr($original, $offset), 2);
  $source_line =~ s/^\s+|\s+$//g;
  print STDERR "$path:$line: forbidden $kind";
  print STDERR ": $source_line" if length $source_line;
  print STDERR "\n";
  $violations++;
}

sub literal_object_bounds {
  my ($masked, $start, $end) = @_;
  return unless $start < $end && substr($masked, $start, 1) eq "{";
  my $close = matching_delimiter($masked, $start);
  # The property range ends immediately before its containing object's closing
  # brace. Trimmed trailing whitespace is therefore allowed before that bound.
  return unless $close >= 0 && $close <= $end && skip_space($masked, $close + 1) >= $end;
  return ($start, $close);
}

sub validate_columns {
  my ($path, $original, $masked, $start, $end) = @_;
  my ($open, $close) = literal_object_bounds($masked, $start, $end);
  if (!defined $open) {
    report_match($path, $original, $start, "dynamic Drizzle columns projection");
    return;
  }
  my @properties = object_properties($masked, $original, $open, $close);
  if (!@properties) {
    report_match($path, $original, $open, "empty Drizzle columns projection");
    return;
  }
  for my $property (@properties) {
    my ($key, $value_start, $value_end, $offset) = @$property;
    if (!defined $key || substr($masked, $value_start, $value_end - $value_start) !~ /^true$/) {
      report_match($path, $original, $offset, "non-positive Drizzle columns projection");
    }
  }
}

sub validate_config;
sub validate_with {
  my ($path, $original, $masked, $start, $end) = @_;
  my ($open, $close) = literal_object_bounds($masked, $start, $end);
  if (!defined $open) {
    report_match($path, $original, $start, "dynamic Drizzle with configuration");
    return;
  }
  for my $relation (object_properties($masked, $original, $open, $close)) {
    my ($key, $value_start, $value_end, $offset) = @$relation;
    if (!defined $key) {
      report_match($path, $original, $offset, "dynamic Drizzle relation configuration");
      next;
    }
    my $value = substr($masked, $value_start, $value_end - $value_start);
    next if $value eq "false";
    if ($value eq "true") {
      report_match($path, $original, $offset, "implicit all-column Drizzle relation");
      next;
    }
    validate_config($path, $original, $masked, $value_start, $value_end, "relation");
  }
}

sub validate_config {
  my ($path, $original, $masked, $start, $end, $context) = @_;
  my ($open, $close) = literal_object_bounds($masked, $start, $end);
  if (!defined $open) {
    report_match($path, $original, $start, "nonliteral Drizzle $context config");
    return;
  }
  my $found_columns = 0;
  for my $property (object_properties($masked, $original, $open, $close)) {
    my ($key, $value_start, $value_end) = @$property;
    next unless defined $key;
    if ($key eq "columns") {
      $found_columns = 1;
      validate_columns($path, $original, $masked, $value_start, $value_end);
    } elsif ($key eq "with") {
      validate_with($path, $original, $masked, $value_start, $value_end);
    }
  }
  report_match($path, $original, $open, "missing Drizzle $context columns projection") unless $found_columns;
}

for my $path (@files) {
  $path =~ s/\0$//;
  next if exempt_test($path);

  if ($path =~ /\.sql$/i) {
    open my $fh, "<", $path or die "unable to read $path: $!\n";
    local $/;
    my $original = <$fh>;
    close $fh;
    my $source = $original;

    # Mask comments and string literals without changing offsets or line numbers.
    $source =~ s{--[^\n]*|/\*.*?\*/|'(?:''|[^'])*'}{blank($&)}gse;
    # Applied Atlas migrations are immutable. A forward migration replaces this
    # legacy view; masking only its exact statement keeps all other SQL enforced.
    if ($path eq "pkg/clickhouse/migrations/20260419000000.sql") {
      $source =~ s{SELECT \* FROM default\.instance_checkpoints_v1 FINAL}{blank($&)}gise;
    }
    if ($path eq "pkg/clickhouse/migrations/20260804000000.sql") {
      $source =~ s{SELECT \*\s+FROM default\.instance_checkpoints_v1\s+FINAL}{blank($&)}gise;
    }

    while ($source =~ /\bsqlc\s*\.\s*embed\s*\(/ig) {
      report_match($path, $original, $-[0], "sqlc.embed all-column selection");
    }
    while ($source =~ /\bselect\s+(?:(?:all|distinct(?:row)?|high_priority|straight_join|sql_(?:small_result|big_result|buffer_result|no_cache|calc_found_rows))\s+)*\*/ig) {
      report_match($path, $original, $-[0], "SELECT wildcard");
    }
    # Requiring FROM after the projection prevents permission targets such as
    # GRANT SELECT ON database.* from looking like qualified selections.
    while ($source =~ /\bselect\b(?:(?!\bfrom\b|;)[\s\S])*?(?:`[^`]+`|[A-Za-z_][A-Za-z0-9_]*)\s*\.\s*\*(?:(?!\bfrom\b|;)[\s\S])*?\bfrom\b/ig) {
      report_match($path, $original, $-[0], "qualified wildcard selection");
    }
    next;
  }

  next unless $path =~ /(?:\.go|\.[cm]?[jt]sx?)$/;
  open my $fh, "<", $path or die "unable to read $path: $!\n";
  local $/;
  my $original = <$fh>;
  close $fh;
  my $source = mask_source_comments($original, $path);

  # Raw SQL also lives in Go and TypeScript string literals. Keep strings while
  # masking source comments, then apply the same projection checks as .sql files.
  while ($source =~ /\bsqlc\s*\.\s*embed\s*\(/ig) {
    report_match($path, $original, $-[0], "sqlc.embed all-column selection");
  }
  while ($source =~ /\bselect\s+(?:(?:all|distinct(?:row)?|high_priority|straight_join|sql_(?:small_result|big_result|buffer_result|no_cache|calc_found_rows))\s+)*\*/ig) {
    report_match($path, $original, $-[0], "SELECT wildcard");
  }
  while ($source =~ /\bselect\b(?:(?!\bfrom\b|;)[\s\S])*?(?:`[^`]+`|[A-Za-z_][A-Za-z0-9_]*)\s*\.\s*\*(?:(?!\bfrom\b|;)[\s\S])*?\bfrom\b/ig) {
    report_match($path, $original, $-[0], "qualified wildcard selection");
  }

  next if $path =~ /\.go$/;

  if ($path =~ m{^web/apps/dashboard/} && $path =~ /\.[cm]?[jt]sx?$/) {
    my $structure = mask_typescript_structure($original);
    my $query_pattern = qr/\.\s*query\s*\.\s*[A-Za-z_\$][A-Za-z0-9_\$]*\s*\.\s*find(?:First|Many)\s*\(/;
    while ($structure =~ /\.\s*query\s*\.\s*[A-Za-z_\$][A-Za-z0-9_\$]*\s*\.\s*find(?:First|Many)\s*<(?:(?!;)[\s\S])*?>\s*\(/g) {
      report_match($path, $original, $-[0], "generic Drizzle relational query");
    }
    my $expected_queries = 0;
    $expected_queries++ while $source =~ /$query_pattern/g;
    my $scanned_queries = 0;
    while ($structure =~ /$query_pattern/g) {
      $scanned_queries++;
      my $call_offset = $-[0];
      my $open = $+[0] - 1;
      my $close = matching_delimiter($structure, $open);
      if ($close < 0) {
        report_match($path, $original, $call_offset, "unbalanced Drizzle relational query");
        next;
      }
      my $config_start = skip_space($structure, $open + 1);
      my $config_end = $close;
      $config_end-- while $config_end > $config_start && substr($structure, $config_end - 1, 1) =~ /\s/;
      validate_config($path, $original, $structure, $config_start, $config_end, "query");
      pos($structure) = $close + 1;
    }
    if ($scanned_queries != $expected_queries) {
      report_match($path, $original, 0, "incomplete Drizzle relational query scan");
    }
  }

  while ($source =~ /\.\s*select\s*\(\s*(?:\[\s*)?(["'`])\s*(?:(?:`[^`]+`|[A-Za-z_][A-Za-z0-9_]*)\s*\.\s*)?\*\s*\1/ig) {
    report_match($path, $original, $-[0], "query-builder string wildcard selection");
  }
  while ($source =~ /\.\s*selectAll\s*\(/ig) {
    report_match($path, $original, $-[0], "query-builder selectAll selection");
  }

  # Requiring the following .from(...) avoids confusing DOM input.select() with
  # Drizzle's empty projection, while allowing normal multiline query chains.
  while ($source =~ /\.\s*select(?:Distinct)?\s*\(\s*\)\s*\.\s*from\s*\(/ig) {
    report_match($path, $original, $-[0], "empty query-builder .select()");
  }
}

if ($violations) {
  print STDERR "Found $violations all-column SQL selection(s). List columns explicitly.\n";
  exit 1;
}
PERL
