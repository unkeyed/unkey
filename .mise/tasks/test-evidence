#!/usr/bin/env bash
#MISE description="Require fresh Go test events, replayable order, and optional red/green witnesses"
set -euo pipefail

export UNKEY_TEST_CONTAINER_SCOPE="${UNKEY_TEST_CONTAINER_SCOPE:-$PWD}"
scope_hash="$(printf "%s" "$UNKEY_TEST_CONTAINER_SCOPE" | shasum -a 256 | cut -c1-12)"
export UNKEY_TEST_COMPOSE_PROJECT="unkey-evidence-${scope_hash}-$$"
cleanup() {
  local status=$?
  docker compose -f pkg/testutil/docker-compose.test.yaml -p "$UNKEY_TEST_COMPOSE_PROJECT" down --volumes >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup EXIT

go run ./tools/testevidence "$@"
