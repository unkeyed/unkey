#!/usr/bin/env bash
#MISE description="Start the Kubernetes development environment for this orb's worker image"
#MISE depends=["install-web"]
#MISE raw=true
set -euo pipefail

source ./dev/disable-aws.sh
if [[ -x /opt/orb-worker/docker-start.sh ]]; then
  exec bash ./dev/orb/start.sh "$@"
fi

source ./dev/local-cluster.sh
with_local_cluster --start ./dev/cluster.orb.yaml tilt up \
  --file ./dev/Tiltfile \
  --host 0.0.0.0 \
  --port "${PORT:-10350}" \
  --stream \
  -- \
  --orb=true "$@"
