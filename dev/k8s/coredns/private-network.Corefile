# BEGIN unkey private network
unkey.internal:53 {
    errors
    cache 5
    loadbalance
    rewrite stop {
        name regex ^([a-z0-9](?:[a-z0-9-]{0,20}[a-z0-9])?)\.unkey-connection-([0-9a-f]{32})\.([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.unkey\.internal\.$ unkey-r-{2}-{1}.{3}.svc.cluster.local.
        answer auto
    }
    rewrite stop {
        name regex ^(unkey-connection-[0-9a-f]{32})\.([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.unkey\.internal\.$ {1}.{2}.svc.cluster.local.
        answer auto
    }
    template ANY ANY unkey.internal {
        rcode NXDOMAIN
    }
    kubernetes cluster.local {
        ttl 5
    }
}
# END unkey private network
