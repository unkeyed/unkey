config.define_string('topolvm_backing_size')
cfg = config.parse()
# Sparse loopback file size. Sparse means this is a ceiling, not a reservation —
# 20 GiB on a fresh cluster costs ~0 bytes. Bump if your test workloads fill more.
TOPOLVM_BACKING_SIZE = cfg.get('topolvm_backing_size', '20G')

# Tilt's background docker pruner: drop stale tilt-* tags it created earlier.
docker_prune_settings(
  num_builds=5,
  keep_recent=1,
  max_age_mins=60,
)

# Check which optional credential files exist
has_depot_credentials = os.path.exists('./.env.depot')
has_github_credentials = os.path.exists('./.env.github') and os.path.exists('./.github-private-key.pem')
has_domain_connect_key = os.path.exists('./.domain-connect-private-key.pem')

# The stripe CLI is "logged in" when it has a configured account. When it is,
# Tilt writes the shared webhook signing secret into both env files and forwards
# test events to the dashboard and ctrl-api webhooks; otherwise this is skipped.
has_stripe_login = str(local(
    "stripe config --list 2>/dev/null | grep -q account_id && echo yes || echo no",
    quiet=True,
    echo_off=True,
)).strip() == "yes"

