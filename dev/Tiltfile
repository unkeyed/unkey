# When the stripe CLI is logged in, capture its signing secret (stable per
# account) and upsert it into both env files, so ctrl-api and the dashboard
# verify forwarded events with the same secret. Runs before the consumers below.
stripe_secret_dep = []
if has_stripe_login:
    local_resource(
        'stripe-webhook-secret',
        '''
        set -eu
        whsec=$(stripe listen --print-secret)
        for f in ./.env.stripe ../web/apps/dashboard/.env; do
          touch "$f"
          if grep -q '^STRIPE_WEBHOOK_SECRET=' "$f"; then
            sed -i.bak "s|^STRIPE_WEBHOOK_SECRET=.*|STRIPE_WEBHOOK_SECRET=$whsec|" "$f" && rm -f "$f.bak"
          else
            printf 'STRIPE_WEBHOOK_SECRET=%s\\n' "$whsec" >> "$f"
          fi
        done
        echo "Wrote STRIPE_WEBHOOK_SECRET to .env.stripe and dashboard .env"
        ''',
        resource_deps=['namespace'],
        labels=['setup'],
        allow_parallel=True,
    )
    stripe_secret_dep = ['stripe-webhook-secret']

local_resource(
    'stripe-credentials',
    'if [ -f ./.env.stripe ]; then kubectl -n unkey create secret generic stripe-credentials --from-env-file=./.env.stripe -o yaml --dry-run=client | kubectl apply -f -; else echo "Skipping stripe-credentials (no .env.stripe file)"; fi',
    resource_deps=['namespace'] + stripe_secret_dep,
