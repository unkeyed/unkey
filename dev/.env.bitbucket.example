# Bitbucket OAuth consumer for the /poc/bitbucket connect flow.
# Copy to dev/.env.bitbucket (gitignored) and fill in real values.
#
# Consumer setup: workspace settings -> OAuth consumers -> Add consumer.
# Callback URL: http://localhost:7091/poc/bitbucket/callback
# Grant types: authorization code + refresh token.
# Permissions: Account read, Repositories read, Webhooks read and write.
UNKEY_BITBUCKET_CLIENT_ID=
UNKEY_BITBUCKET_CLIENT_SECRET=
# Public base URL Bitbucket delivers webhooks to (ngrok tunnel in local dev).
UNKEY_BITBUCKET_PUBLIC_WEBHOOK_URL=
