# GitLab OAuth application credentials for the /poc/gitlab connect flow.
# Copy this to .env.gitlab and fill in your values.
#
# Create the application at https://gitlab.com/-/user_settings/applications:
#   - Redirect URI: http://localhost:7091/poc/gitlab/callback
#   - Confidential: yes
#   - Scopes: api

UNKEY_GITLAB_CLIENT_ID=
UNKEY_GITLAB_CLIENT_SECRET=

# Publicly reachable base URL for webhook delivery (your ngrok tunnel).
UNKEY_GITLAB_PUBLIC_WEBHOOK_URL=https://example.ngrok-free.app
