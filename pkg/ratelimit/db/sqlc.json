{
  "version": "2",
  "sql": [
    {
      "engine": "mysql",
      "queries": "./queries",
      "schema": ["../../mysql/schema/ratelimit_state.sql"],
      "codegen": [
        {
          "out": ".",
          "plugin": "bulk-insert",
          "options": {
            "emit_methods_with_db_argument": true
          }
        }
      ],
      "gen": {
        "go": {
          "package": "db",
          "out": ".",
          "sql_package": "database/sql",
          "query_parameter_limit": 1,
          "overrides": [
            { "db_type": "any", "nullable": true, "go_type": "int64" }
          ],
          "emit_db_tags": true,
          "emit_interface": true,
          "emit_sql_as_comment": true,
          "emit_methods_with_db_argument": true,
          "output_files_suffix": "_generated",
          "output_models_file_name": "models_generated",
          "output_querier_file_name": "querier_generated",
          "output_db_file_name": "delete_me"
        }
      }
    }
  ],
  "plugins": [
    {
      "name": "bulk-insert",
      "process": {
        "cmd": "../../mysql/plugins/dist/bulk-insert"
      }
    }
  ]
}
